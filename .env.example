# Copy this file to .env and fill in your own values. Never commit .env.
# These are placeholders only.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=energy_consumption
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=energy_consumption

# Optional: use a different dataset file than dataset/household_power_consumption.txt
# DATASET_PATH=/full/path/to/household_power_consumption.txt
